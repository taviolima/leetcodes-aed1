/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     struct TreeNode *left;
 *     struct TreeNode *right;
 * };
 */
int maxDepth(struct TreeNode* root) {
    if (root == NULL){
        return 0;
    }

    int Altura;

    int altEsq = maxDepth(root->left);
    int altDir = maxDepth(root->right);


    if(altEsq >= altDir){
        Altura = altEsq;
    } else {
        Altura = altDir;
    }

    return Altura + 1;
}
