bool predictTheWinner(int* nums, int numsSize) {
    int somaP1 = 0;
    int somaP2 = 0;

    for(int i = 0; i < numsSize; i++){
        if (i % 2 == 0){
            somaP1 += nums[i];
        }else{
            somaP2 += nums[i];
        }
    }

    if(somaP1 >= somaP2){
        return true;
    }else{
        return false;
    } 
}

