int romanToInt(char* s) {
    int total = 0;

    for(int i = 0; s[i] != '\0'; i++){
        
        int atual;
        int prox;
        
        if(s[i] == 'I'){
            atual = 1;
        }else if(s[i] == 'V'){
            atual = 5;
        }else if(s[i] == 'X'){
            atual = 10;
        }else if(s[i] == 'L'){
            atual = 50;
        }else if(s[i] == 'C'){
            atual = 100;
        }else if(s[i] == 'D'){
            atual = 500;
        }else {
            atual = 1000;
        }

        if(s[i + 1] == 'I'){
            prox = 1;
        }else if(s[i + 1] == 'V'){
            prox = 5;
        }else if(s[i + 1] == 'X'){
            prox = 10;
        }else if(s[i + 1] == 'L'){
            prox = 50;
        }else if(s[i + 1] == 'C'){
            prox = 100;
        }else if(s[i + 1] == 'D'){
            prox = 500;
        }else if(s[i + 1] == 'M'){
            prox = 1000;
        }else{
            prox = 0;
        }

        if(atual < prox){
            total = total - atual;
        }else{
            total = total + atual;
        }
    }

    return total;
}
